{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["$app/types", "bun"],
		"rootDirs": [
			".",
			".svelte-kit/types"
		],
		"paths": {
			"$lib": ["./src/lib"],
			"$lib/*": ["./src/lib/*"],
			"#lib": ["./src/lib"],
			"#lib/*": ["./src/lib/*"]
		}
	},
	"include": [
		"src",
		"test",
		"*",
		".svelte-kit/types/**/*"
	],
	"exclude": [
		"src/service-worker",
		"src/service-worker.js",
		"src/service-worker.ts"
	]
}
